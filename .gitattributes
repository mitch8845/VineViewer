# Normalize line endings. Development happens on Windows, but CI builds the
# APK on Linux -- without this, generated files show as perpetually modified
# and diffs fill with whole-file line-ending churn.
* text=auto eol=lf

# Scripts that must keep platform-native endings to stay executable.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
gradlew.bat text eol=crlf
gradlew     text eol=lf

# Binary files -- never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.zip  binary
*.jar  binary
*.apk  binary
*.aab  binary
*.jks     binary
*.keystore binary
*.xlsx binary
