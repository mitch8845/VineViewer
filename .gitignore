# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets — NEVER commit these.
# The release keystore is unrecoverable if lost and unrotatable if leaked.
# Back it up offline; store the CI copy in GitHub Secrets.
*.jks
*.keystore
key.properties
android/key.properties

# Claude Code machine-local settings (permissions, etc.) — not project config
.claude/settings.local.json
